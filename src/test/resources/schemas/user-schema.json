{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "name",
    "email",
    "gender",
    "status"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "description": "Уникальный идентификатор пользователя"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Имя пользователя"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email пользователя"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ],
      "description": "Пол"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "description": "Статус"
    }
  },
  "additionalProperties": false
}